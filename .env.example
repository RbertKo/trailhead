# Copy to .env.local and fill in. The key is server-side only: never prefix it
# with NEXT_PUBLIC_ and never commit it.
# Create a key at https://dev.meta.ai (API keys tab).
MODEL_API_KEY=

# The app uses muse-spark-1.3 (Standard). Contributor mode is about 12x cheaper on
# input and 21x on output, but Meta may train future models on the content sent,
# so uncomment this for development only, never with real user data.
# META_TEXT_MODEL=muse-spark-1.3-contributor

# Optional overrides, shown with their defaults.
# META_API_BASE_URL=https://api.meta.ai/v1
# META_SEGMENT_MODEL=sam-3.1
# API_RATE_LIMIT_PER_MINUTE=30
